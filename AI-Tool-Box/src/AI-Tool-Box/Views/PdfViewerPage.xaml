<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_Tool_Box.Views.PdfViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        PDF 查看器（C# 原生实现）：
          • 查看/翻页/缩放：Windows.Data.Pdf 渲染到位图（系统内置，无需 JS）
          • 批注（文字/画笔）：Image 上方叠加 Canvas（Polyline / TextBlock）
          • 裁剪：拖拽矩形选区（Rectangle 叠加）
          • 导出（含批注/裁剪）与合并：隐藏 PdfToolWeb 承载 pdf.html（pdf-lib）处理
        Row0 工具行（横向滚动）；Row1 查看区；Row2 状态栏。
    -->
    <Grid Padding="16" RowSpacing="12"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Row 0: 工具行（横向滚动，窄窗口时不溢出） ===== -->
        <ScrollViewer Grid.Row="0"
                      Margin="0,0,0,10"
                      HorizontalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="打开 PDF…"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnOpenClick"/>
                <Button Content="◀" ToolTipService.ToolTip="上一页" Click="OnPrevClick"/>
                <TextBlock x:Name="PageIndicator"
                           Text="– / –"
                           VerticalAlignment="Center"
                           MinWidth="70"
                           TextAlignment="Center"
                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                <Button Content="▶" ToolTipService.ToolTip="下一页" Click="OnNextClick"/>
                <Rectangle Width="1" Height="24" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                <Button Content="＋" ToolTipService.ToolTip="放大" Click="OnZoomInClick" Padding="10,4"/>
                <Button Content="－" ToolTipService.ToolTip="缩小" Click="OnZoomOutClick" Padding="10,4"/>
                <Button Content="适应宽度" ToolTipService.ToolTip="页面适应窗口宽度" Click="OnFitWidthClick"/>
                <Rectangle Width="1" Height="24" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                <ToggleButton x:Name="ToolPanBtn" Content="浏览" IsChecked="True" Click="OnToolClick"/>
                <ToggleButton x:Name="ToolTextBtn" Content="文字批注"
                              ToolTipService.ToolTip="点击页面添加文字批注" Click="OnToolClick"/>
                <ToggleButton x:Name="ToolPenBtn" Content="画笔批注"
                              ToolTipService.ToolTip="在页面上自由绘制批注" Click="OnToolClick"/>
                <ToggleButton x:Name="ToolCropBtn" Content="裁剪"
                              ToolTipService.ToolTip="拖拽选择区域后点击「应用裁剪」" Click="OnToolClick"/>
                <Rectangle Width="1" Height="24" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                <Button Content="清除批注" ToolTipService.ToolTip="清除当前页批注（Alt+点击清除全部）"
                        Click="OnClearAnnotsClick"/>
                <Button Content="应用裁剪" ToolTipService.ToolTip="按选中的矩形区域裁剪当前页并导出"
                        Click="OnApplyCropClick"/>
                <Rectangle Width="1" Height="24" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                <Button Content="合并 PDF…" ToolTipService.ToolTip="选择多个 PDF 按顺序合并" Click="OnMergeClick"/>
                <Button Content="导出" Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="导出当前文档（含文字/画笔批注）" Click="OnExportClick"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Row 1: 查看区（Image + 批注/裁剪叠加层） ===== -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer x:Name="ViewScroller"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          ZoomMode="Disabled">
                <Grid x:Name="ViewHost"
                      MinWidth="8" MinHeight="8"
                      Background="Transparent"
                      RenderTransformOrigin="0,0">
                    <Image x:Name="PageImage" Stretch="None"/>
                    <!-- 批注/画笔叠加层（与渲染图同尺寸） -->
                    <Canvas x:Name="AnnotCanvas"
                            Background="Transparent"
                            PointerPressed="OnCanvasPointerPressed"
                            PointerMoved="OnCanvasPointerMoved"
                            PointerReleased="OnCanvasPointerReleased"
                            PointerExited="OnCanvasPointerExited"
                            IsHitTestVisible="False"/>
                    <!-- 裁剪选区框 -->
                    <Rectangle x:Name="CropRect"
                               Stroke="#00E5FF" StrokeThickness="2"
                               Fill="#2200E5FF"
                               Visibility="Collapsed"
                               IsHitTestVisible="False"/>
                    <!-- 空状态提示 -->
                    <TextBlock x:Name="EmptyHint"
                               Text="点击上方「打开 PDF」选择文件"
                               Foreground="#6A7B8C" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- 裁剪提示 -->
                    <Border x:Name="CropHint"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,16"
                            Background="#CC000000" CornerRadius="6" Padding="10,6"
                            Visibility="Collapsed">
                        <TextBlock Text="拖拽选择裁剪区域，然后点击「应用裁剪」"
                                   Foreground="#9FB6C6" FontSize="12"/>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ===== Row 2: 状态栏 ===== -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Text="未打开文档"
                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                   FontSize="12"/>

        <!-- 隐藏 PDF 工具页（pdf-lib：合并 / 批注+裁剪导出） -->
        <WebView2 x:Name="PdfToolWeb"
                  Grid.Row="1"
                  Width="1" Height="1"
                  Opacity="0"
                  IsHitTestVisible="False"
                  Visibility="Collapsed"/>
    </Grid>
</Page>
