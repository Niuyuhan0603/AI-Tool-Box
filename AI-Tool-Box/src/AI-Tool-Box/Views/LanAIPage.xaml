<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_Tool_Box.Views.LanAIPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AI_Tool_Box.ViewModels"
    xmlns:svc="using:AI_Tool_Box.Services"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="16" RowSpacing="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Row 0: 顶栏信息 + 服务端开关 ===== -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="局域网 AI 服务" Style="{StaticResource TitleTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.InfoText, Mode=OneWay}" Opacity="0.8"/>
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{x:Bind ViewModel.ServerButtonText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleServerCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        MinWidth="140"/>
                <Button Grid.Column="2"
                        Content="保存设置"
                        Command="{x:Bind ViewModel.SaveSettingsCommand}"/>
            </Grid>
        </Border>

        <!-- ===== Row 1: 左右两列 = 服务端 / 客户端 ===== -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== 左列：本机 AI 代理服务端配置 ========== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <!-- 服务端核心参数 -->
                    <controls:Expander Header="服务端参数" IsExpanded="True">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="后端类型：" MinWidth="90" VerticalAlignment="Center"/>
                                <ComboBox SelectedIndex="{x:Bind ViewModel.BackendInt, Mode=TwoWay}" MaxWidth="180" MinWidth="140">
                                    <x:String>本机 Ollama</x:String>
                                    <x:String>本机 API（Task4）</x:String>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Ollama 地址：" MinWidth="90" VerticalAlignment="Center"/>
                                <TextBox Text="{x:Bind ViewModel.OllamaBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="300" HorizontalAlignment="Left" PlaceholderText="http://localhost:11434"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="API 基地址：" MinWidth="90" VerticalAlignment="Center"/>
                                <TextBox Text="{x:Bind ViewModel.ApiForwardBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="300" HorizontalAlignment="Left" PlaceholderText="如 https://api.openai.com/v1（仅后端=API 时使用）"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="服务端端口：" MinWidth="90" VerticalAlignment="Center"/>
                                <NumberBox Value="{x:Bind ViewModel.ServerPort, Mode=TwoWay}" Minimum="1" Maximum="65535" MaxWidth="180" MinWidth="140"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox Content="允许通过本机 API Key 转发（有额度风险）"
                                          IsChecked="{x:Bind ViewModel.AllowApiForward, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox Content="程序启动时自动开启服务端"
                                          IsChecked="{x:Bind ViewModel.AutoStartServer, Mode=TwoWay}"/>
                            </StackPanel>
                        </StackPanel>
                    </controls:Expander>

                    <!-- 黑白名单 -->
                    <controls:Expander Header="授权模式与黑白名单" IsExpanded="True">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="模式：" Width="80" VerticalAlignment="Center"/>
                                <ComboBox SelectedIndex="{x:Bind ViewModel.ModeInt, Mode=TwoWay}" MaxWidth="180" MinWidth="140">
                                    <x:String>黑名单（默认允许）</x:String>
                                    <x:String>白名单（默认拒绝）</x:String>
                                </ComboBox>
                                <CheckBox Content="未知 IP 弹授权询问"
                                          IsChecked="{x:Bind ViewModel.PromptUnknownIp, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="黑名单（逗号分隔 IP）：" Opacity="0.8"/>
                                <TextBox Text="{x:Bind ViewModel.BlacklistCsv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="如 192.168.1.50,10.0.0.33"
                                         IsSpellCheckEnabled="False"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="白名单（逗号分隔 IP）：" Opacity="0.8"/>
                                <TextBox Text="{x:Bind ViewModel.WhitelistCsv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="如 192.168.1.10,192.168.1.11"
                                         IsSpellCheckEnabled="False"/>
                            </StackPanel>
                        </StackPanel>
                    </controls:Expander>

                    <!-- 待授权请求 -->
                    <controls:Expander Header="待授权请求（对方调用时弹这里，手动允许/拒绝）" IsExpanded="True">
                        <StackPanel Spacing="6">
                            <ListView ItemsSource="{x:Bind ViewModel.PendingAuth, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedAuthRequest, Mode=TwoWay}"
                                      MinHeight="140" MaxHeight="240"
                                      SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="svc:LanAiAuthRequest">
                                        <Border Padding="8,4" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6" Margin="0,2">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Display}" FontWeight="SemiBold"/>
                                                <TextBlock Opacity="0.7" FontSize="12">
                                                    <Run Text="请求时间："/>
                                                    <Run Text="{Binding RequestedAtUtc}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="允许（加入白名单）" Command="{x:Bind ViewModel.AllowAuthCommand}" Style="{StaticResource AccentButtonStyle}"/>
                                <Button Content="允许仅此一次" Command="{x:Bind ViewModel.AllowAuthOnceCommand}"/>
                                <Button Content="拒绝（加入黑名单）" Command="{x:Bind ViewModel.DenyAuthCommand}"/>
                                <Button Content="拒绝仅此一次" Command="{x:Bind ViewModel.DenyAuthOnceCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </controls:Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== 右列：客户端 发现 / 保存端点 ========== -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <!-- 在线服务器 -->
                    <controls:Expander Header="在线 AI 服务器（点扫描发现同局域网其他电脑）" IsExpanded="True">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="扫描局域网"
                                        Command="{x:Bind ViewModel.ScanPeersCommand}"
                                        Style="{StaticResource AccentButtonStyle}"/>
                                <ProgressRing IsActive="{x:Bind ViewModel.IsScanningPeers, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.IsScanningPeers, Mode=OneWay}"
                                              Width="20" Height="20"/>
                                <TextBlock Text="（点击后等待 4 秒收集中）" VerticalAlignment="Center" Opacity="0.7"/>
                            </StackPanel>

                            <ListView ItemsSource="{x:Bind ViewModel.OnlinePeers, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedOnlinePeer, Mode=TwoWay}"
                                      MinHeight="120" MaxHeight="200">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="svc:LanAiPeer">
                                        <Border Padding="8,4" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6" Margin="0,2">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Display}" FontWeight="SemiBold"/>
                                                <TextBlock Opacity="0.7" FontSize="12">
                                                    <Run Text="最后发现："/>
                                                    <Run Text="{Binding LastSeenUtc}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="名称：" VerticalAlignment="Center" Opacity="0.8"/>
                                <TextBox Text="{x:Bind ViewModel.SaveEndpointName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MinWidth="160" MaxWidth="280"
                                         PlaceholderText="自定义显示名，如 客厅 3090"/>
                                <Button Content="保存端点"
                                        Command="{x:Bind ViewModel.SaveSelectedPeerCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </controls:Expander>

                    <!-- 已保存端点 -->
                    <controls:Expander Header="已保存端点（AI 页面内答题 → 模式=局域网 即可选择）" IsExpanded="True">
                        <StackPanel Spacing="6">
                            <ListView ItemsSource="{x:Bind ViewModel.SavedEndpoints, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedSavedEndpoint, Mode=TwoWay}"
                                      MinHeight="120" MaxHeight="220">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="svc:LanAiSavedEndpoint">
                                        <Border Padding="8,4" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6" Margin="0,2">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Opacity="0.8" FontSize="12" Text="{Binding BaseUrl}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Opacity="0.6" FontSize="12">
                                                    <Run Text="{Binding OwnerMachine}"/>
                                                    <Run Text=" @ "/>
                                                    <Run Text="{Binding OwnerIp}"/>
                                                    <Run Text="  · 添加 "/>
                                                    <Run Text="{Binding AddedAtUtc}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Content="删除选中端点"
                                    Command="{x:Bind ViewModel.RemoveSavedCommand}"/>
                        </StackPanel>
                    </controls:Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== Row 2: 底部操作 ===== -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,6">
            <TextBlock Text="提示：保存端点后，到侧栏“AI 页面内答题”→ 模式 选择“局域网（已就绪）”，即可通过保存的远端 AI 进行答题。"
                       Opacity="0.8"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Page>
