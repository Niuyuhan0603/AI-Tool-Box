<Page
    x:Class="AI_Tool_Box.Views.AutoAnswerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：配置面板（整体可上下滚动，窗口变小时仍可完整访问） -->
        <ScrollViewer Grid.Column="0"
                      Padding="14,12,10,12"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10">
                <TextBlock Text="自动答题" FontSize="24" FontWeight="Bold"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                           Text="对刷题网站（如洛谷）自动生成代码并提交。离线模式：先在右侧浏览器打开题目页，手动拾取各区域并填写题组 URL 规律；联网模式：由 AI 直接操控右侧浏览器。"/>

                <RadioButtons x:Name="ModeSelector" SelectedIndex="0" SelectionChanged="OnModeChanged">
                    <x:String>离线模式：手动指定区域</x:String>
                    <x:String>联网模式：AI 驱动浏览器</x:String>
                </RadioButtons>

                <!-- ===== 离线模式 ===== -->
                <StackPanel x:Name="OfflinePanel" Spacing="10">
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="题组与语言" FontWeight="SemiBold"/>
                            <TextBox x:Name="UrlTemplateBox" Header="题组网址规律（用 {n} 表示题号）"
                                     PlaceholderText="https://www.luogu.com.cn/problem/P{n}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <NumberBox Grid.Column="0" x:Name="StartIndexBox" Header="起始题号"
                                           Value="1001" Minimum="0" SpinButtonPlacementMode="Compact"/>
                                <NumberBox Grid.Column="1" x:Name="StepBox" Header="题号步长"
                                           Value="1" Minimum="1" SpinButtonPlacementMode="Compact"/>
                            </Grid>
                            <TextBox x:Name="LanguageBox" Header="编程语言" Text="C++"/>
                            <Button Content="打开题组起始页预览" Click="OnPreviewClick"/>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="区域拾取（点「拾取」后在右侧网页单击目标，Esc 取消）" FontWeight="SemiBold" TextWrapping="Wrap"/>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="题目区域" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox Grid.Column="1" x:Name="ProblemSelectorBox" FontFamily="Consolas" FontSize="12"
                                         PlaceholderText="CSS 选择器（留空=整页正文）"/>
                                <Button Grid.Column="2" Content="拾取" Click="OnPickProblemClick"/>
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="代码输入区" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox Grid.Column="1" x:Name="TypeSelectorBox" FontFamily="Consolas" FontSize="12"
                                         PlaceholderText="AI 生成的代码将填入此处"/>
                                <Button Grid.Column="2" Content="拾取" Click="OnPickTypeClick"/>
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="提交按钮" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox Grid.Column="1" x:Name="SubmitSelectorBox" FontFamily="Consolas" FontSize="12"
                                         PlaceholderText="提交代码按钮"/>
                                <Button Grid.Column="2" Content="拾取" Click="OnPickSubmitClick"/>
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="判题结果区" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox Grid.Column="1" x:Name="ErrorSelectorBox" FontFamily="Consolas" FontSize="12"
                                         PlaceholderText="显示 AC/WA 等结果的区域"/>
                                <Button Grid.Column="2" Content="拾取" Click="OnPickErrorClick"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="本机 Ollama（离线代码生成）" FontWeight="SemiBold"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="ModelBox" Header="模型" IsEditable="True"
                                          HorizontalAlignment="Stretch" PlaceholderText="选择或输入模型名"/>
                                <Button Grid.Column="1" Content="刷新" VerticalAlignment="Bottom" Click="OnRefreshModelsClick"/>
                            </Grid>
                            <TextBox x:Name="BaseUrlBox" Header="Ollama 地址" Text="http://localhost:11434"/>
                            <TextBlock x:Name="ModelStatusText" FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                                       Text="点「刷新」读取本机已安装模型。"/>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="运行" FontWeight="SemiBold"/>
                            <NumberBox x:Name="RunCountBox" Header="本次题数（跑完自动停止）"
                                       Value="1" Minimum="1" SpinButtonPlacementMode="Compact"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="RunOfflineButton" Content="开始自动答题"
                                        Style="{StaticResource AccentButtonStyle}" Click="OnRunOfflineClick"/>
                                <Button x:Name="StopOfflineButton" Content="停止" IsEnabled="False" Click="OnStopClick"/>
                                <ProgressRing x:Name="OfflineRing" IsActive="False" Width="20" Height="20"
                                              VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== 联网模式 ===== -->
                <StackPanel x:Name="OnlinePanel" Spacing="10" Visibility="Collapsed">
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="AI 浏览器控制" FontWeight="SemiBold"/>
                            <TextBox x:Name="GoalBox" Header="任务目标" AcceptsReturn="True" TextWrapping="Wrap"
                                     Height="90"
                                     PlaceholderText="例如：打开洛谷 P1001，写一份能通过的 C++ 代码并提交，确认结果是否为 AC"/>
                            <NumberBox x:Name="MaxStepsBox" Header="最大步数" Value="30" Minimum="1"
                                       SpinButtonPlacementMode="Compact"/>
                            <ComboBox x:Name="OnlineApiSelector" Header="API 档案（仅显示连通性测试通过的）"
                                      HorizontalAlignment="Stretch" PlaceholderText="选择用于联网答题的 API"
                                      SelectionChanged="OnOnlineApiChanged"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="RetestApisButton" Content="重新测试连通性" Click="OnRetestApisClick"/>
                                <TextBlock x:Name="ApiTestStatusText" FontSize="12" Opacity="0.75"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="切到联网模式时自动测试各档案连通性。"/>
                            </StackPanel>
                            <TextBlock FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                                       Text="AI 通过输出 JSON 动作（navigate/click/type/read/readpage/wait/done）操控右侧浏览器；使用上方选中的 API 档案模型。"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="RunOnlineButton" Content="开始（AI 操作浏览器）"
                                        Style="{StaticResource AccentButtonStyle}" Click="OnRunOnlineClick"/>
                                <Button x:Name="StopOnlineButton" Content="停止" IsEnabled="False" Click="OnStopClick"/>
                                <ProgressRing x:Name="OnlineRing" IsActive="False" Width="20" Height="20"
                                              VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="运行日志" FontWeight="SemiBold"/>
                        <TextBox x:Name="LogBox" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="12" Height="220"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 右侧：内嵌浏览器（页面拾取 / 自动操作的目标） -->
        <Border Grid.Column="1" x:Name="WebShellSlot" Background="Transparent"/>
    </Grid>
</Page>
