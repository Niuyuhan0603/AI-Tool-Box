<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_Tool_Box.Views.MoleculePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16,12" RowSpacing="10"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="分子模拟器" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="（SMILES 绘制 / 原子拼装、分子式·分子量·不饱和度、官能团、同分异构体与稳定构型、AI 解释、导出 SVG/PNG）"
                       Opacity="0.8" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="SMILES" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="1" x:Name="SmilesBox" AcceptsReturn="False" TextWrapping="Wrap"
                                 FontFamily="Consolas"
                                 Text="CC(=O)OC1=CC=CC=C1C(=O)O"
                                 PlaceholderText="如：CC(=O)OC1=CC=CC=C1C(=O)O"/>

                        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="绘制" Style="{StaticResource AccentButtonStyle}" Click="OnDrawClick"/>
                                <Button Content="导出 SVG…" Click="OnExportSvgClick"/>
                                <Button Content="导出 PNG…" Click="OnExportPngClick"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="3" Spacing="6">
                            <TextBox x:Name="NameBox" Header="化学名称（中文/英文/IUPAC 均可）"
                                     PlaceholderText="如：阿司匹林 / aspirin / 2-acetoxybenzoic acid"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="AI：名称 → SMILES" Click="OnAiNameToSmilesClick"/>
                                <Button Content="AI：解释结构/性质" Click="OnAiExplainClick"/>
                                <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Row="4" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="6" Padding="10">
                            <TextBlock x:Name="InfoText" Text="分子式 / 分子量：—" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True" FontFamily="Consolas"/>
                        </Border>

                        <!-- 化学反应预测：ΔH / ΔS / ΔG / K / Arrhenius 速率 -->
                        <Expander Grid.Row="5" Header="化学反应预测（ΔG · 速率）"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <TextBox x:Name="ReactantsBox"
                                         Header="反应物（SMILES 或化学式，多个用 + 分隔；也可直接写整式）"
                                         FontFamily="Consolas" Text="C2H4 + H2"
                                         PlaceholderText="如：C2H4 + H2　或　2H_{2}+O_{2}"
                                         TextChanged="OnReactionInputChanged"/>
                                <TextBox x:Name="ProductsBox"
                                         Header="产物（同上）"
                                         FontFamily="Consolas" Text="C2H6"
                                         PlaceholderText="如：C2H6"
                                         TextChanged="OnReactionInputChanged"/>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TempBox" Header="温度 T (K)" Text="298"/>
                                    <TextBox Grid.Column="1" x:Name="EaBox" Header="活化能 Ea (kJ/mol，可留空)"/>
                                </Grid>
                                <Button Content="预测 ΔG 与反应速率" Style="{StaticResource AccentButtonStyle}"
                                        Click="OnPredictReactionClick"/>
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        CornerRadius="6" Padding="10,6">
                                    <StackPanel Spacing="4">
                                        <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                                                   Text="二维排版预览（类 LaTeX：_{下标}、^{上标}、-&gt; / → / ⇌、系数、\frac，像卡西欧一样看得懂）"/>
                                        <Grid x:Name="ReactionTypesetHost" MinHeight="30"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="ReactionResultText" FontFamily="Consolas" FontSize="12"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                           Text="输入反应物/产物（SMILES 或化学式），点击按钮估算 ΔG、平衡常数与 Arrhenius 速率。"/>
                            </StackPanel>
                        </Expander>

                        <Grid Grid.Row="6" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="160"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="AI 解释" FontWeight="SemiBold"/>
                            <TextBox Grid.Row="1" x:Name="AiOutput" AcceptsReturn="True" TextWrapping="Wrap"
                                     IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     PlaceholderText="AI 的结构与性质说明"/>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="#0A0F14"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <WebView2 x:Name="Preview"/>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                   Text="结构渲染使用本地 SmilesDrawer（离线）；AI 互转需要「设置 → 右侧栏AI辅助」中的提供商与 API-Key。"/>
    </Grid>
</Page>
