<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_Tool_Box.Views.MusicPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 音乐播放器页：借鉴 MusicPlayer2 布局（左：曲绘+信息+歌词滚动；右：歌曲列表；底部：播放控制栏），
         全部为原生 WinUI 控件 + 深色科技风。播放使用系统 MediaPlayer，
         歌词/封面/收藏均由 MusicPlayerService 纯 C# 实现。 -->
    <Grid Background="#FF0A0F14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 主体两栏（右栏宽度随窗口自适应，见代码 OnMainWindowSizeChanged） ==================== -->
        <Grid Margin="16,14,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightCol" Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏：曲绘 + 歌曲信息 + 歌词滚动 -->
            <Grid Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <FontFamily x:Key="SegoeIconFont">Segoe MDL2 Assets</FontFamily>
                    </StackPanel.Resources>
                    <!-- 曲绘 -->
                    <Border Width="200" Height="200" CornerRadius="14"
                            Background="#1A2733" BorderBrush="#33FFFFFF" BorderThickness="1">
                        <Image x:Name="CoverImage" Stretch="UniformToFill"
                               Source="ms-appx:///Assets/H+_logo-transparent.ico"/>
                    </Border>
                    <!-- 歌曲信息 -->
                    <StackPanel VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock x:Name="TitleText" Text="未在播放" FontSize="24" FontWeight="SemiBold"
                                   Foreground="#F0FBFF" TextWrapping="Wrap" MaxWidth="340"/>
                        <TextBlock x:Name="ArtistText" Text="—" FontSize="14" Foreground="#9FB6C6"
                                   TextWrapping="Wrap" MaxWidth="340" Margin="0,8,0,0"/>
                        <ToggleButton x:Name="FavToggle" Content="收藏" Click="OnFavToggleClick"
                                      Padding="12,4" FontSize="12" Margin="0,12,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 歌词滚动区 -->
                <Border Grid.Row="2" CornerRadius="10" Background="#141B24"
                        BorderBrush="#22FFFFFF" BorderThickness="1" Margin="0,14,0,0">
                    <Grid>
                        <ScrollViewer x:Name="LyricScroller" VerticalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Auto" Padding="20,12">
                            <StackPanel x:Name="LyricPanel"/>
                        </ScrollViewer>
                        <TextBlock x:Name="LyricEmptyHint" Text="暂无歌词（请在歌曲同目录放置同名 .lrc 文件）"
                                   Foreground="#66808F" FontSize="13" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 右栏：歌曲列表 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="AddFolderBtn" Content="添加音乐文件夹" Click="OnAddFolderClick" FontSize="12" Padding="12,6"/>
                    <ComboBox x:Name="SortCombo" SelectedIndex="0" SelectionChanged="OnSortChanged" FontSize="12"
                              MinWidth="128" VerticalAlignment="Center" Margin="8,0,0,0">
                        <ComboBoxItem Content="按添加顺序"/>
                        <ComboBoxItem Content="按标题"/>
                        <ComboBoxItem Content="按艺术家"/>
                        <ComboBoxItem Content="按专辑"/>
                        <ComboBoxItem Content="按时长"/>
                    </ComboBox>
                    <ToggleButton x:Name="FavFilterBtn" Content="只看收藏" Click="OnFavFilterClick"
                                  FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <TextBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="搜索歌曲 / 歌手 / 专辑"
                         TextChanged="OnSearchChanged" Margin="0,0,0,10" FontSize="12"/>

                <ListView x:Name="SongList" Grid.Row="2" SelectionChanged="OnSongSelected"
                          SelectionMode="Single" Background="Transparent" BorderThickness="0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FavDisplay}" FontSize="14"
                                           Foreground="#FFB300" VerticalAlignment="Center"
                                           MinWidth="18"/>
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="13" Foreground="#E8F6FF"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DisplaySubtitle}" FontSize="11" Foreground="#7E96A8"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11"
                                           Foreground="#7E96A8" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- ==================== 底部播放控制栏 ==================== -->
        <Grid Grid.Row="1" Background="#141B24" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0"
              Padding="16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 控制按钮组 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PrevBtn" Content="&#xE892;" FontFamily="Segoe MDL2 Assets"
                        Click="OnPrevClick" Width="40" Height="40" FontSize="16"/>
                <Button x:Name="PlayBtn" Content="&#xE768;" FontFamily="Segoe MDL2 Assets"
                        Click="OnPlayPauseClick" Width="52" Height="52" FontSize="20" Margin="8,0,0,0"/>
                <Button x:Name="NextBtn" Content="&#xE893;" FontFamily="Segoe MDL2 Assets"
                        Click="OnNextClick" Width="40" Height="40" FontSize="16" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- 进度条 + 时间 -->
            <Grid Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionText" Text="00:00" FontSize="12" Foreground="#9FB6C6"
                           VerticalAlignment="Center"/>
                <Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.001"
                        ValueChanged="OnProgressScrubbed" VerticalAlignment="Center" Margin="10,0"/>
                <TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00" FontSize="12" Foreground="#9FB6C6"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- 播放模式 + 音量 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ModeBtn" Content="列表顺序" Click="OnModeClick" FontSize="12" Padding="10,4"/>
                <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="#9FB6C6" Margin="14,0,6,0"/>
                <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="100" Value="80"
                        ValueChanged="OnVolumeChanged" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
