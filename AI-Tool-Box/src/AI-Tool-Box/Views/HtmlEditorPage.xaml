<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_Tool_Box.Views.HtmlEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16,12" RowSpacing="10"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="HTML 编辑器" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="（富文本排版 + AI 改写/续写/润色 + 导出 HTML / PDF / DOCX / PPTX / SVG / 演示文稿）"
                       Opacity="0.8" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="新建（清空）" Click="OnClearClick"/>
                <Button Content="插入示例" Click="OnSampleClick"/>
                <Button Content="导出 HTML…" Click="OnExportHtmlClick"/>
                <Button Content="导出 PDF…" Click="OnExportPdfClick"/>
                <Button Content="导出 DOCX…" Click="OnExportDocxClick"/>
                <Button Content="导出 PPTX…" Click="OnExportPptxClick"/>
                <Button Content="导出 SVG…" Click="OnExportSvgClick"/>
                <Button Content="演示模式预览" Click="OnPreviewDeckClick"
                        ToolTipService.ToolTip="在应用内全屏播放当前内容（按幻灯片切分）"/>
                <Button Content="导出演示文稿 HTML…" Click="OnExportDeckClick"
                        ToolTipService.ToolTip="导出便携播放器 HTML：点击/方向键翻页、Esc 退出；含媒体时自动生成同名 .assets 文件夹"/>
                <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <WebView2 x:Name="Editor"/>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                   Text="幻灯片切分约定：优先按 section.slide 分页；否则按 hr 分节线分页；再否则按 h1 分组；均无则整篇作为一页。导出演示文稿时含本地媒体会在 HTML 同级生成同名 .assets 文件夹并以相对路径引用。"/>

        <Grid x:Name="DeckPreviewOverlay" Grid.Row="0" Grid.RowSpan="4" Canvas.ZIndex="50"
              Visibility="Collapsed" Background="#0A0F14">
            <WebView2 x:Name="DeckPreview"/>
            <Button Content="退出预览 (Esc)" Click="OnExitPreviewClick"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape"/>
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>
    </Grid>
</Page>
