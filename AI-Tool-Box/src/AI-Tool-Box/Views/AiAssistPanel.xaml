<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AI_Tool_Box.Views.AiAssistPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AI_Tool_Box.ViewModels"
    xmlns:local="using:AI_Tool_Box.Views">

    <UserControl.Resources>
        <!-- 用户气泡：右侧对齐 + 人像头像 -->
        <DataTemplate x:Key="UserBubbleTemplate" x:DataType="vm:AiAssistMsgRow">
            <Grid Margin="0,3" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        HorizontalAlignment="Right"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="10"
                        Padding="10,7"
                        MaxWidth="560">
                    <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                </Border>
                <Border Grid.Column="1"
                        Width="30" Height="30"
                        CornerRadius="15"
                        VerticalAlignment="Top"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <FontIcon Glyph="&#xE77B;" FontSize="14"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- AI 气泡：左侧对齐 + 机器头像 + 生成中动画 -->
        <DataTemplate x:Key="AiBubbleTemplate" x:DataType="vm:AiAssistMsgRow">
            <Grid Margin="0,3" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="30" Height="30"
                        CornerRadius="15"
                        VerticalAlignment="Top"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE99A;" FontSize="14"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                </Border>
                <Border Grid.Column="1"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,7"
                        MaxWidth="560">
                    <StackPanel Spacing="5">
                        <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"/>
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    Visibility="{x:Bind GeneratingVisibility, Mode=OneWay}">
                            <ProgressRing Width="14" Height="14"
                                          IsActive="{x:Bind IsGenerating, Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind ReceivingText, Mode=OneWay}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <local:AiAssistRoleSelector x:Key="AiRoleSelector"
                                    UserTemplate="{StaticResource UserBubbleTemplate}"
                                    AssistantTemplate="{StaticResource AiBubbleTemplate}"/>
    </UserControl.Resources>

    <Border BorderThickness="1,0,0,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid Padding="12,10" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Row 0: 标题 + 关闭 ===== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="AI 辅助" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Click="OnCloseClick"
                        ToolTipService.ToolTip="收起 AI 辅助侧栏" Padding="6,2">
                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                </Button>
            </Grid>

            <!-- ===== Row 1: 提供商 + 模型 ===== -->
            <Grid Grid.Row="1" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          Header="提供商"
                          ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          HorizontalAlignment="Stretch"/>
                <ComboBox Grid.Column="1" Header="模型"
                          IsEditable="True"
                          Text="{x:Bind ViewModel.Model, Mode=TwoWay}"
                          ItemsSource="{x:Bind ViewModel.AvailableModels, Mode=OneWay}"
                          PlaceholderText="如 llama3.2:1b"
                          HorizontalAlignment="Stretch"/>
                <Button Grid.Column="2" Content="刷新" Click="OnRefreshModelsClick"
                        VerticalAlignment="Bottom" Margin="0,0,0,1"
                        ToolTipService.ToolTip="从本地 Ollama 重新读取已安装模型"/>
            </Grid>

            <!-- ===== Row 2: 提示 + Key 状态 + 网页内容选取 ===== -->
            <StackPanel Grid.Row="2" Spacing="3">
                <TextBlock Text="{x:Bind ViewModel.StatusHint, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind ViewModel.KeyStatusText, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Grid.Column="0" Content="选取网页内容…"
                            Click="OnPickPageContentClick"
                            ToolTipService.ToolTip="按区块勾选，或截图框选，只把选中的结构化 HTML 发给 AI"/>
                    <Button x:Name="PickElementButton" Grid.Column="1" Content="页面拾取"
                            Click="OnPickElementClick"
                            ToolTipService.ToolTip="像开发者工具一样在网页上点击目标区域，自动提取对应的结构化 HTML"/>
                    <Button Grid.Column="2" Content="清除附带"
                            Visibility="{x:Bind ViewModel.AttachedVisibility, Mode=OneWay}"
                            Click="OnClearAttachedClick"
                            ToolTipService.ToolTip="不再附带已选取的网页片段"/>
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.AttachedSummary, Mode=OneWay}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- ===== Row 3: 消息列表（用户/AI 气泡 + 头像） ===== -->
            <ListView x:Name="MessageList"
                      Grid.Row="3"
                      ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                      ItemTemplateSelector="{StaticResource AiRoleSelector}"
                      SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,1"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- ===== Row 4: 提示词 + 输入 + 按钮 ===== -->
            <StackPanel Grid.Row="4" Spacing="6">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              PlaceholderText="常用提示词（选中即插入输入框）"
                              ItemsSource="{x:Bind ViewModel.PromptPresets, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedPromptPreset, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="1" Content="压缩历史"
                            Command="{x:Bind ViewModel.CompressHistoryCommand}"
                            ToolTipService.ToolTip="让 AI 把已有对话总结成摘要，之后用摘要继续对话以节省 token"/>
                </Grid>
                <TextBox Text="{x:Bind ViewModel.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="输入问题，Enter 发送，Shift+Enter 换行"
                         AcceptsReturn="True"
                         MaxLength="8000"
                         MinHeight="64"
                         MaxHeight="140"
                         TextWrapping="Wrap"
                         KeyDown="OnInputKeyDown"/>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="发送"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.SendCommand}"
                            HorizontalAlignment="Stretch"
                            ToolTipService.ToolTip="发送当前输入（Enter）"/>
                    <Button Grid.Column="1" Content="停止"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                            Command="{x:Bind ViewModel.StopCommand}"
                            ToolTipService.ToolTip="停止当前流式回复"/>
                    <Button Grid.Column="2" Content="清空"
                            Command="{x:Bind ViewModel.ClearCommand}"
                            ToolTipService.ToolTip="清空当前对话记录"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
