<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_Tool_Box.Views.SoftwareAutomationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16,12" RowSpacing="10"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="工程 / 3D 软件自动化" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="（Blender / FreeCAD / AutoCAD / Python / 自定义命令行 + AI 生成脚本）"
                       Opacity="0.8" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="PresetBox" Header="目标软件" SelectedIndex="0"
                              SelectionChanged="OnPresetChanged">
                        <x:String>Blender</x:String>
                        <x:String>FreeCAD</x:String>
                        <x:String>AutoCAD</x:String>
                        <x:String>Python</x:String>
                        <x:String>自定义</x:String>
                    </ComboBox>
                    <TextBox Grid.Column="1" x:Name="ExeBox" Header="可执行文件路径"
                             PlaceholderText="例如 C:\Program Files\Blender Foundation\Blender\blender.exe"/>
                    <Button Grid.Column="2" Content="浏览…" Click="OnBrowseExeClick" VerticalAlignment="Bottom"/>
                </Grid>

                <TextBox x:Name="ArgsBox" Header="命令行参数（{script} 会替换为临时脚本路径）"
                         Text="--background --python &quot;{script}&quot;"/>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RunButton" Content="运行脚本" Style="{StaticResource AccentButtonStyle}"
                                Click="OnRunClick"/>
                        <Button Content="示例脚本" Click="OnSampleClick"/>
                        <Button Content="打开…" Click="OnOpenClick"/>
                        <Button Content="保存…" Click="OnSaveClick"/>
                        <Button Content="AI 生成脚本" Click="OnAiGenerateClick"/>
                        <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20"
                                      VerticalAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="脚本" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="1" x:Name="ScriptBox" AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="13"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PlaceholderText="Python / AutoLISP(.scr) 等脚本内容"/>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="输出" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="1" x:Name="OutputBox" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                   Text="仅以命令行/脚本接口驱动外部软件（不注入进程）；请确认目标软件已安装并允许后台运行。"/>
    </Grid>
</Page>
