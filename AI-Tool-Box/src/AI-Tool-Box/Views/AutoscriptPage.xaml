<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_Tool_Box.Views.AutoscriptPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16,12" RowSpacing="10"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Autoscript" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="（Lua 沙箱脚本 + 工具箱 API + ATS1 加密打包）" Opacity="0.8" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RunButton" Content="运行" Style="{StaticResource AccentButtonStyle}" Click="OnRunClick"/>
                <Button Content="示例脚本" Click="OnSampleClick"/>
                <Button Content="打开…" Click="OnOpenClick"/>
                <Button Content="保存 .lua…" Click="OnSaveClick"/>
                <Button Content="加密保存 .luaenc…" Click="OnEncryptSaveClick"/>
                <Button Content="清空输出" Click="OnClearLogClick"/>
                <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="脚本（Lua）" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="1" x:Name="ScriptBox" AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="13"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PlaceholderText="在此编写 Lua 脚本，点击「运行」执行"/>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="运行输出" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="1" x:Name="LogBox" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Grid.Row="2" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                               Text="可用 API（都用点号调用）：toolbox.log(msg) / toolbox.now() / toolbox.sleep(ms) / toolbox.ai(prompt) / toolbox.http_get(url) / toolbox.file_read(path) / toolbox.file_write(path, text) / toolbox.file_exists(path) / toolbox.app_dir() / toolbox.navigate(&quot;Sniffer&quot;) / toolbox.cancel_requested()"/>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                   Text="沙箱已禁用 io/os/load 等危险库；toolbox.ai 会调用「设置 → 右侧栏AI辅助」中的提供商。"/>
    </Grid>
</Page>
