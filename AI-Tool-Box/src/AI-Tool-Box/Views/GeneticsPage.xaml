<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_Tool_Box.Views.GeneticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  HorizontalScrollMode="Disabled" VerticalScrollMode="Auto"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16" Spacing="10">

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="生物 / 遗传模拟器" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="（孟德尔杂交比例、哈代-温伯格平衡、AI 解释结果）" Opacity="0.8"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 杂交计算 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="基因型杂交（单/双基因）" FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="FatherBox" Width="140" Header="父本基因型" Text="Aa" PlaceholderText="Aa / AaBb"/>
                        <TextBox x:Name="MotherBox" Width="140" Header="母本基因型" Text="Aa" PlaceholderText="Aa / AaBb"/>
                        <Button Content="计算子代" Style="{StaticResource AccentButtonStyle}"
                                Click="OnCrossClick" VerticalAlignment="Bottom"/>
                        <Button Content="双基因示例" Click="OnDihybridSampleClick" VerticalAlignment="Bottom"/>
                    </StackPanel>

                    <TextBlock x:Name="CrossStatus" Opacity="0.85" TextWrapping="Wrap" FontSize="12"
                               Text="大写字母表示显性等位基因；Aa × Aa → 显性:隐性 = 3:1。"/>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="子代基因型比例" FontWeight="SemiBold"/>
                            <ListView x:Name="GenotypeList" Height="200" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas"/>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="子代表现型比例" FontWeight="SemiBold"/>
                            <ListView x:Name="PhenotypeList" Height="200" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas"/>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 哈代-温伯格 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="哈代-温伯格平衡" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="PBox" Width="120" Header="等位基因频率 p" Text="0.6"/>
                        <Button Content="计算" Style="{StaticResource AccentButtonStyle}"
                                Click="OnHardyWeinbergClick" VerticalAlignment="Bottom"/>
                        <Button Content="由显性表现型频率反推" Click="OnInferFromPhenotypeClick" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <TextBlock x:Name="HwResult" TextWrapping="Wrap" FontFamily="Consolas"
                               IsTextSelectionEnabled="True"
                               Text="输入 p（0–1）后计算 AA / Aa / aa 的基因型频率。"/>
                </StackPanel>
            </Border>

            <!-- AI 解释 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="AI 解释 / 出题" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="解释当前结果" Click="OnAiExplainClick"/>
                        <Button Content="生成同类练习题" Click="OnAiQuizClick" Style="{StaticResource AccentButtonStyle}"/>
                        <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20"/>
                    </StackPanel>
                    <TextBox x:Name="AiOutput" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                             Height="180" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PlaceholderText="AI 输出（需要先在 设置 → 右侧栏AI辅助 配置提供商）"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.8" TextWrapping="Wrap"
                       Text="说明：显性上位、连锁互换、复等位基因等复杂情形请使用 AI 出题/解释。"/>
        </StackPanel>
    </ScrollViewer>
</Page>
