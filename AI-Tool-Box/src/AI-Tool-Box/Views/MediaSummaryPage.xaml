<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_Tool_Box.Views.MediaSummaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16,12" RowSpacing="10"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="音视频 AI 智能总结" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="（ffmpeg 抽取音频 → Whisper 转写 → AI 总结）" Opacity="0.8" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 文件与参数 -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="选择音视频…" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.PickMediaCommand}"/>
                        <Button Content="抽取音频" Command="{x:Bind ViewModel.ExtractAudioCommand}"/>
                        <Button Content="语音转写" Command="{x:Bind ViewModel.TranscribeCommand}"/>
                        <Button Content="导入字幕/文本…" Command="{x:Bind ViewModel.ImportTranscriptCommand}"/>
                        <TextBlock Text="总结风格：" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{x:Bind ViewModel.FocusOptions}"
                                  SelectedItem="{x:Bind ViewModel.Focus, Mode=TwoWay}" Width="140"/>
                        <TextBlock Text="转写语言：" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{x:Bind ViewModel.LanguageOptions}"
                                  SelectedItem="{x:Bind ViewModel.Language, Mode=TwoWay}" Width="100"/>
                        <Button Content="AI 总结" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.SummarizeCommand}"/>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20"
                                      VerticalAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Text="{x:Bind ViewModel.InputPath, Mode=OneWay}" Opacity="0.85" FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{x:Bind ViewModel.AudioPath, Mode=OneWay}" Opacity="0.65" FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
                <ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Maximum="1" Height="4"/>
            </StackPanel>
        </Border>

        <!-- 转写 / 总结 双栏 -->
        <Grid Grid.Row="3" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="转写稿（可直接编辑 / 粘贴字幕）" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="1"
                             Text="{x:Bind ViewModel.Transcript, Mode=TwoWay}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PlaceholderText="转写结果将显示在这里；也可以手动粘贴文本或导入 .srt/.txt"/>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="AI 总结（Markdown）" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="复制" Command="{x:Bind ViewModel.CopySummaryCommand}"/>
                        <Button Content="保存…" Command="{x:Bind ViewModel.SaveSummaryCommand}"/>
                    </StackPanel>
                    <TextBox Grid.Row="1"
                             Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                             AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PlaceholderText="总结结果"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <TextBlock Grid.Row="4" Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                   FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
    </Grid>
</Page>
