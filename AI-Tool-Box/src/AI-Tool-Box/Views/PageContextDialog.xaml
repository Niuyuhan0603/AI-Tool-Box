<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="AI_Tool_Box.Views.PageContextDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AI_Tool_Box.Views"
    Title="选取网页内容"
    PrimaryButtonText="附带选中内容"
    CloseButtonText="取消"
    DefaultButton="Primary"
    MaxWidth="960"
    PrimaryButtonClick="OnPrimaryClick">

    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Auto"
                  VerticalScrollMode="Auto"
                  ZoomMode="Disabled">
        <Grid Width="820" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- 顶部提示 + 重新抓取 -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HintText"
                       Grid.Column="0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="只把选取的部分发给 AI：先在“按区块选择”里勾选有效区块，或切到“截图框选”直接框出需要的区域。"/>
            <Button Grid.Column="1" Content="重新抓取" Click="OnReloadClick"/>
        </Grid>

        <!-- 两种选取方式 -->
        <Pivot x:Name="Modes" Grid.Row="1" SelectionChanged="OnModeChanged">
            <PivotItem Header="按区块选择">
                <Grid ColumnSpacing="10" Height="360">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ListView x:Name="BlockList"
                              Grid.Column="0"
                              SelectionMode="Single"
                              SelectionChanged="OnBlockSelectionChanged"
                              BorderThickness="1"
                              CornerRadius="4"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:PageBlockItem">
                                <Grid ColumnSpacing="6" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              MinWidth="0"
                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Grid.Column="1"
                            BorderThickness="1"
                            CornerRadius="4"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <ScrollViewer Padding="8" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="BlockPreview"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Text="勾选左侧区块后，这里会显示将要发给 AI 的结构化 HTML。"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </PivotItem>

            <PivotItem Header="截图框选">
                <Grid Height="360" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="120"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ShotHint"
                               Grid.Row="0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="正在截取当前网页可视区域…"/>

                    <Border Grid.Row="1"
                            x:Name="ShotBorder"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BorderThickness="1"
                            CornerRadius="4"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid x:Name="ShotHost" Background="#14000000">
                            <Image x:Name="ShotImage" Stretch="Fill"/>
                            <Canvas x:Name="ShotCanvas"
                                    Background="Transparent"
                                    PointerPressed="OnShotPointerPressed"
                                    PointerMoved="OnShotPointerMoved"
                                    PointerReleased="OnShotPointerReleased"
                                    PointerCanceled="OnShotPointerReleased"
                                    PointerCaptureLost="OnShotPointerReleased">
                                <Rectangle x:Name="ShotRect"
                                           Visibility="Collapsed"
                                           Fill="#334D8BFD"
                                           Stroke="#FF4D8BFD"
                                           StrokeThickness="1"/>
                            </Canvas>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            BorderThickness="1"
                            CornerRadius="4"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <ScrollViewer Padding="8" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="ShotPreview"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Text="框选后，这里会显示反推得到的结构化 HTML。"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </PivotItem>
        </Pivot>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
    </ScrollViewer>
</ContentDialog>
