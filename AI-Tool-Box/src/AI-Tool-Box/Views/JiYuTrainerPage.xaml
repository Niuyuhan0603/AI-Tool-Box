<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_Tool_Box.Views.JiYuTrainerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 整页：开机界面同款代码雨铺满（welcome.html?rain=1，复用同一 Canvas 实现）→
         功能面板（半透明卡片）悬浮其上。不再启动/嵌入 JiYuTrainer.exe 窗口，
         全部核心功能由 JiYuCoreService（纯 C# 移植自 JiYuTrainer 源码）直接调用。 -->
    <Grid Background="#FF0A0F14">
        <Grid x:Name="RainHost"/>

        <!-- 顶部标题 -->
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="20,14,0,0"
                    VerticalAlignment="Top" HorizontalAlignment="Left">
            <FontIcon Glyph="&#xE95F;" FontSize="18" Foreground="#00E5FF"/>
            <TextBlock Text="极域教室控制 · 功能面板" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="#B0F7FF"/>
        </StackPanel>

        <!-- 主功能面板（半透明卡片，可滚动） -->
        <ScrollViewer Margin="20,56,20,20" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled">
            <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Stretch">

                <!-- 状态区 -->
                <Border Padding="14" CornerRadius="8" Background="#D91A2733"
                        BorderBrush="#33FFFFFF" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="状态" FontWeight="SemiBold" Foreground="#00E5FF" FontSize="14"/>
                        <TextBlock x:Name="StatusPid" Text="StudentMain PID：—" Foreground="#E0FFFF" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock x:Name="StatusPath" Text="学生端路径：—" Foreground="#C8E6F5" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock x:Name="StatusPwd" Text="极域密码：—" Foreground="#FFD54F" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 核心操作区 -->
                <Border Padding="14" CornerRadius="8" Background="#D91A2733"
                        BorderBrush="#33FFFFFF" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="核心操作" FontWeight="SemiBold" Foreground="#00E5FF" FontSize="14"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="破解密码" Click="OnBreakPwdClick" MinWidth="96"/>
                            <Button Content="杀死极域" Click="OnKillClick" MinWidth="96"/>
                            <Button Content="重启极域" Click="OnRerunClick" MinWidth="96"/>
                            <Button Content="解除控屏" Click="OnBreakScreenClick" MinWidth="96"/>
                            <Button Content="刷新状态" Click="OnRefreshClick" MinWidth="96"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- UDP 攻击区 -->
                <Border Padding="14" CornerRadius="8" Background="#D91A2733"
                        BorderBrush="#33FFFFFF" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="UDP 攻击（远程命令 / 消息 / 关机 / 重启）" FontWeight="SemiBold" Foreground="#00E5FF" FontSize="14"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="UdpIp" PlaceholderText="目标 IP（如 192.168.80.129）"
                                     MinWidth="200" VerticalAlignment="Center"/>
                            <TextBox x:Name="UdpPort" PlaceholderText="端口" Text="4705"
                                     Width="90" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox x:Name="UdpPayload" PlaceholderText="命令或消息内容（如 taskkill /f /im StudentMain.exe）"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="发送命令" Click="OnUdpCmdClick" MinWidth="96"/>
                            <Button Content="发送消息" Click="OnUdpMsgClick" MinWidth="96"/>
                            <Button Content="远程关机" Click="OnUdpShutdownClick" MinWidth="96"/>
                            <Button Content="远程重启" Click="OnUdpRebootClick" MinWidth="96"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 结果日志 -->
                <Border Padding="14" CornerRadius="8" Background="#D91A2733"
                        BorderBrush="#33FFFFFF" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="操作日志" FontWeight="SemiBold" Foreground="#00E5FF" FontSize="14"/>
                        <TextBlock x:Name="ResultText" Text="就绪。" Foreground="#E0FFFF" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
