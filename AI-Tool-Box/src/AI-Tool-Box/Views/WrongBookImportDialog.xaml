<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="AI_Tool_Box.Views.WrongBookImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="导入预览与选题"
    PrimaryButtonText="完成"
    CloseButtonText="取消"
    DefaultButton="Primary"
    MaxWidth="1440">

    <!--
        错题本导入预览：直接预览来源文件（PDF 原文 / DOCX 渲染 HTML / 图片）。
          • 预览区支持缩放（＋/－/适应宽度/100% 或 Ctrl+滚轮）并可上下/左右滚动；
          • 预览区与右侧操作面板之间的分隔条可拖拽，调整预览窗口大小；
          • 框选像截图工具：任意起点按住左键拖拽，四个方向均可画矩形；
          • 加入错题时把裁剪区域渲染为 PNG 缩略图（写入 ThumbnailPath / AnswerImagePath）。
        布局自适应窗口：Opened 时按 XamlRoot 尺寸调整 RootGrid 宽高，内部可滚动。
    -->
    <!-- 宽高由代码按窗口实际可用尺寸设置（Opened 时计算），保证标题、按钮与操作面板始终可见 -->
    <Grid x:Name="RootGrid" MinWidth="560" MinHeight="320" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="InfoText" Grid.Row="0" TextWrapping="Wrap" FontSize="12"
                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>

        <Grid x:Name="BodyGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- 预览区 -->
            <Border Grid.Column="0" BorderThickness="1" CornerRadius="6"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 缩放 / 翻页工具条（横向可滚动，窄窗口下按钮也不会被挤出） -->
                    <Border Grid.Row="0" BorderThickness="0,0,0,1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      VerticalScrollMode="Disabled">
                            <StackPanel x:Name="ZoomBar" Orientation="Horizontal" Spacing="6" Padding="6">
                                <Button Content="－" Padding="10,2" ToolTipService.ToolTip="缩小" Click="OnZoomOutClick"/>
                                <Button Content="＋" Padding="10,2" ToolTipService.ToolTip="放大" Click="OnZoomInClick"/>
                                <Button Content="适应宽度" ToolTipService.ToolTip="页面适应预览区宽度" Click="OnFitWidthClick"/>
                                <Button Content="100%" ToolTipService.ToolTip="实际大小" Click="OnZoomResetClick"/>
                                <TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center" MinWidth="48"
                                           TextAlignment="Center"/>
                                <Rectangle Width="1" Height="20" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                           VerticalAlignment="Center" Margin="4,0"/>
                                <!-- PDF 翻页（就在预览区上方，确保一定看得见） -->
                                <Button x:Name="PrevBtn" Content="◀ 上一页" Visibility="Collapsed"
                                        ToolTipService.ToolTip="上一页" Click="OnPrevClick"/>
                                <TextBlock x:Name="PageIndicator" Text="– / –" MinWidth="56"
                                           TextAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <Button x:Name="NextBtn" Content="下一页 ▶" Visibility="Collapsed"
                                        ToolTipService.ToolTip="下一页" Click="OnNextClick"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 滚动条常显（Auto 会自动隐藏，用户看不到“滑动条”） -->
                    <ScrollViewer x:Name="PreviewScroller" Grid.Row="1"
                                  HorizontalScrollBarVisibility="Visible"
                                  VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Enabled"
                                  ZoomMode="Disabled">
                        <Grid x:Name="PreviewHost" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Image x:Name="PreviewImage" Stretch="Fill"/>
                            <!-- 框选叠加层：CropRect 作为 Canvas 的子元素，Canvas.SetLeft/SetTop 才生效 -->
                            <Canvas x:Name="CropCanvas" Background="Transparent"
                                    PointerPressed="OnCanvasPointerPressed"
                                    PointerMoved="OnCanvasPointerMoved"
                                    PointerReleased="OnCanvasPointerReleased"
                                    PointerCaptureLost="OnCanvasPointerCaptureLost">
                                <Rectangle x:Name="CropRect" Stroke="#00E5FF" StrokeThickness="2"
                                           Fill="#2200E5FF" Visibility="Collapsed" IsHitTestVisible="False"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>

                    <WebView2 x:Name="DocxWeb" Grid.Row="1" Visibility="Collapsed"/>
                    <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="正在加载预览…"
                               Foreground="#6A7B8C" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 可拖拽分隔条：调整下方「预览区」与「操作面板」的宽度 -->
            <Border Grid.Column="1" x:Name="Splitter" Width="10" Background="Transparent"
                    Margin="2,0"
                    PointerPressed="OnSplitterPointerPressed"
                    PointerMoved="OnSplitterPointerMoved"
                    PointerReleased="OnSplitterPointerReleased"
                    PointerCaptureLost="OnSplitterPointerCaptureLost"
                    ToolTipService.ToolTip="拖拽调整预览区宽度">
                <Rectangle Width="2" HorizontalAlignment="Center"
                           Fill="{ThemeResource CardStrokeColorDefaultBrush}"/>
            </Border>

            <!-- 操作面板（整列可上下滚动：窗口很小时按钮仍可通过滚动看到，不会凭空消失） -->
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="6">
                    <TextBlock x:Name="TypeText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>

                <ComboBox Grid.Row="1" x:Name="TargetBox" Header="加入为" SelectedIndex="0"
                          HorizontalAlignment="Stretch">
                    <x:String>题目图片（缩略图）</x:String>
                    <x:String>答案图片</x:String>
                </ComboBox>

                <StackPanel Grid.Row="2" Spacing="6">
                    <Button x:Name="AddRegionBtn" Content="＋ 加入错题（选区/整页）"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}" Click="OnAddRegionClick"/>
                    <Button x:Name="AddSelectionBtn" Content="＋ 加入选中文字"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}" Click="OnAddSelectionClick"/>
                    <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="12" Opacity="0.8"/>
                </StackPanel>

                <TextBlock Grid.Row="3" x:Name="AddedCountText" Text="已加入 0 条" FontWeight="SemiBold"/>

                <ListView Grid.Row="4" x:Name="AddedList" SelectionMode="Single"
                          MinHeight="120" MaxHeight="320"
                          BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="64" Height="64" CornerRadius="4"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Image Source="{Binding Thumb}" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Display}" TextWrapping="Wrap"
                                           MaxLines="3" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            </ScrollViewer>
        </Grid>

        <!-- 底部操作条：包一层 ScrollViewer，窄窗口下文字不换行挤压按钮 -->
        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="移除选中" Click="OnRemoveClick"/>
                <Button Content="清空" Click="OnClearClick"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Opacity="0.85"
                           MaxWidth="560" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
