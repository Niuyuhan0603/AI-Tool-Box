<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_Tool_Box.Views.MessagingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  HorizontalScrollMode="Disabled" VerticalScrollMode="Auto"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16" Spacing="10">

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="通讯软件接入" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="（Telegram Bot 自动收发 + 企业微信/钉钉/飞书/Slack Webhook 推送）"
                           Opacity="0.8" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Telegram Bot -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Telegram Bot（长轮询）" FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TokenBox" Header="Bot Token"
                                 PlaceholderText="从 @BotFather 获取，如 123456:ABC-DEF..."/>
                        <ToggleSwitch Grid.Column="1" x:Name="AiSwitch" Header="AI 回复" IsOn="True"
                                      OnContent="开" OffContent="关" VerticalAlignment="Bottom"/>
                        <Button Grid.Column="2" Content="启动" Style="{StaticResource AccentButtonStyle}"
                                Click="OnStartBotClick" VerticalAlignment="Bottom"/>
                        <Button Grid.Column="3" Content="停止" Click="OnStopBotClick" VerticalAlignment="Bottom"/>
                    </Grid>

                    <TextBlock x:Name="BotStatusText" Text="未启动" Opacity="0.85" FontSize="12"/>

                    <TextBlock Text="运行日志" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <TextBox x:Name="BotLogBox" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                             Height="160" FontFamily="Consolas" FontSize="12"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>

            <!-- Webhook -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Webhook 单向推送（机器人通知 / 群提醒）" FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="KindBox" Width="140" Header="平台" SelectedIndex="0">
                            <x:String>企业微信</x:String>
                            <x:String>钉钉</x:String>
                            <x:String>飞书</x:String>
                            <x:String>Slack</x:String>
                            <x:String>自定义 JSON</x:String>
                        </ComboBox>
                        <TextBox x:Name="WebhookUrlBox" Width="560" Header="Webhook 地址"
                                 PlaceholderText="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=..."/>
                        <Button Content="发送" Style="{StaticResource AccentButtonStyle}"
                                Click="OnSendWebhookClick" VerticalAlignment="Bottom"/>
                    </StackPanel>

                    <TextBox x:Name="WebhookTextBox" Header="消息内容" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="90" PlaceholderText="要推送的文字（支持换行）"/>

                    <TextBlock x:Name="WebhookResultText" FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                               Text="未发送。"/>
                </StackPanel>
            </Border>

            <TextBlock FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                       Text="说明：个人微信/QQ 无官方开放接口，本模块只接入官方机器人能力；Token 使用 DPAPI 加密保存在本机。"/>
        </StackPanel>
    </ScrollViewer>
</Page>
