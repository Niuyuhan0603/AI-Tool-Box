<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_Tool_Box.Views.MindMapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16,12" RowSpacing="10"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Markdown 思维导图" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="（# 标题 / - 列表 自动成树；右侧图上可直接增删改、改父级、设置节点/连线样式，双向同步 Markdown，支持导出 SVG / PNG / HTML / MD）"
                       TextWrapping="Wrap" Opacity="0.8" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧编辑区 -->
            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Markdown 源" FontWeight="SemiBold"/>

                    <Grid Grid.Row="1" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{x:Bind ViewModel.Topic, Mode=TwoWay}"
                                 PlaceholderText="AI 主题（如：光合作用知识点）"/>
                        <Button Grid.Column="1" Content="AI 生成" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.GenerateCommand}"/>
                    </Grid>

                    <TextBox Grid.Row="2"
                             Text="{x:Bind ViewModel.Markdown, Mode=TwoWay}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="Consolas"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                        <Button Content="Markdown 转思维导图" Click="OnRenderClick" Style="{StaticResource AccentButtonStyle}"/>
                        <Button Content="示例" Command="{x:Bind ViewModel.SampleCommand}"/>
                        <Button Content="清空" Command="{x:Bind ViewModel.ClearCommand}"/>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20"
                                      VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧预览 -->
            <Border Grid.Column="1"
                    Background="#0A0F14"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <WebView2 x:Name="Preview"/>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                   FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
    </Grid>
</Page>
