<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_Tool_Box.Views.SnifferPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AI_Tool_Box.ViewModels"
    xmlns:svc="using:AI_Tool_Box.Services"
    xmlns:conv="using:AI_Tool_Box.Converters">

    <Page.Resources>
        <conv:BoolToStringConverter x:Key="SnifferOnOffText" TrueValue="停止嗅探" FalseValue="开始嗅探"/>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- 迷你地址栏（用户需求 3：嗅探器必须有自己的网址导航栏） -->
            <RowDefinition Height="Auto"/>
            <!-- 嗅探控制条 -->
            <RowDefinition Height="Auto"/>
            <!-- 主体：左侧网页（占大部分空间）+ 右侧嗅探结果面板 -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Row 0: 迷你网址导航栏 ===== -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="网页："
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,4,0"/>

                <Button Grid.Column="1" Click="OnMiniBackClick" Padding="6,2" ToolTipService.ToolTip="后退">
                    <FontIcon Glyph="&#xE72B;" FontFamily="{StaticResource SymbolThemeFontFamily}"/>
                </Button>
                <Button Grid.Column="2" Click="OnMiniForwardClick" Padding="6,2" ToolTipService.ToolTip="前进">
                    <FontIcon Glyph="&#xE72A;" FontFamily="{StaticResource SymbolThemeFontFamily}"/>
                </Button>

                <TextBox x:Name="MiniUrlBox"
                         Grid.Column="3"
                         PlaceholderText="输入视频网页网址（如 B 站/YouTube/网页课程）"
                         KeyDown="OnMiniUrlKeyDown"/>

                <Button Grid.Column="4"
                        Content="前往"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnMiniGoClick"/>

                <Button Grid.Column="5" Click="OnMiniRefreshClick" Padding="6,2" ToolTipService.ToolTip="刷新">
                    <FontIcon Glyph="&#xE72C;" FontFamily="{StaticResource SymbolThemeFontFamily}"/>
                </Button>
            </Grid>
        </Border>

        <!-- ===== Row 1: 嗅探控制条 ===== -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="{x:Bind ViewModel.IsSniffingOn, Mode=OneWay, Converter={StaticResource SnifferOnOffText}}"
                        Command="{x:Bind ViewModel.ToggleSniffingCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        MinWidth="130"/>

                <Button Grid.Column="1"
                        Content="扫描当前页"
                        Command="{x:Bind ViewModel.ScanCurrentPageCommand}"/>

                <!-- 用户需求 4：全局重新嗅探（重试） -->
                <Button Grid.Column="2"
                        Content="重新嗅探"
                        Command="{x:Bind ViewModel.ScanCurrentPageCommand}"
                        ToolTipService.ToolTip="重新扫描当前网页，捕获遗漏的媒体资源"/>

                <Button Grid.Column="3"
                        Content="清空列表"
                        Command="{x:Bind ViewModel.ClearAllCommand}"/>

                <Button Grid.Column="4"
                        Content="下载选中资源"
                        Command="{x:Bind ViewModel.DownloadSelectedCommand}"
                        Style="{StaticResource AccentButtonStyle}"/>

                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="m3u8 并发：" VerticalAlignment="Center" Opacity="0.8"/>
                    <NumberBox Value="{x:Bind ViewModel.M3u8Concurrency, Mode=TwoWay}"
                               Minimum="1" Maximum="256" SmallChange="8" Width="96"/>
                </StackPanel>

                <TextBlock Grid.Column="6"
                           Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Opacity="0.85"/>
            </Grid>
        </Border>

        <!-- ===== Row 2: 左网页 + 右嗅探结果面板（用户需求 3） ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- 左：网页可视区（WebShellSlot 挂载）；浏览器保留绝大部分空间 -->
            <Border Grid.Column="0"
                    x:Name="WebShellSlot"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>

            <!-- 视觉分隔线 -->
            <Border Grid.Column="1" Width="1"
                    Background="{ThemeResource CardStrokeColorDefaultBrush}"
                    HorizontalAlignment="Stretch"/>

            <!-- 右：嗅探到的媒体资源 + 下载任务（原底部横条改为右侧竖栏，网页因此获得更多纵向空间） -->
            <Border Grid.Column="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <!-- 资源列表标题 -->
                    <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="6"
                          Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="嗅探到的媒体资源" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.7"
                                   Text="{x:Bind ViewModel.Resources.Count, Mode=OneWay}"/>
                    </Grid>

                    <!-- 资源列表（可滚动） -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Resources, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedResource, Mode=TwoWay}"
                              SelectionMode="Single"
                              ContextRequested="OnResourcesContextRequested">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="10,6"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="svc:SnifferResourceItem">
                                <StackPanel Spacing="3">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                CornerRadius="4"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                Padding="6,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KindDisplay}"
                                                       Foreground="White"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="{Binding Url}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis">
                                        <Run Text="大小："/>
                                        <Run Text="{Binding SizeDisplay}"/>
                                        <Run Text="   · 来源："/>
                                        <Run Text="{Binding PageTitle}"/>
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Click="OnItemDownloadClick" Padding="8,2" ToolTipService.ToolTip="下载此资源">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE896;" FontSize="12"/>
                                                <TextBlock Text="下载" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OnItemRetryClick" Padding="8,2" ToolTipService.ToolTip="重试（重新下载此资源）">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                                                <TextBlock Text="重试" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- 下载任务标题 -->
                    <Border Grid.Row="2" Height="1" Margin="0,2"
                            Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
                    <TextBlock Grid.Row="3" Text="下载任务" FontWeight="SemiBold"
                               Margin="12,6,12,4"/>

                    <!-- 下载任务列表（可滚动） -->
                    <ListView Grid.Row="4"
                              ItemsSource="{x:Bind ViewModel.Downloads, Mode=OneWay}"
                              SelectionMode="None"
                              Padding="0,0,0,6">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="10,6"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="svc:SnifferDownloadTask">
                                <StackPanel Spacing="4">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" Opacity="0.8" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ProgressPercentDisplay, Mode=OneWay}" FontSize="12"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" Height="4"/>
                                    <Grid ColumnSpacing="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Opacity="0.65" FontSize="11" TextTrimming="CharacterEllipsis">
                                            <Run Text="进度："/>
                                            <Run Text="{Binding ReceivedDisplay}"/>
                                            <Run Text=" / "/>
                                            <Run Text="{Binding TotalDisplay}"/>
                                            <Run Text="   · 输出："/>
                                            <Run Text="{Binding LocalPath}"/>
                                        </TextBlock>
                                        <Button Grid.Column="1" Click="OnDownloadRetryClick" Padding="8,2"
                                                ToolTipService.ToolTip="重试失败的下载">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                                                <TextBlock Text="重试" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
