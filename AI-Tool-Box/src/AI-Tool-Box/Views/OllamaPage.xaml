<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_Tool_Box.Views.OllamaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  HorizontalScrollMode="Disabled"
                  VerticalScrollMode="Auto"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16" Spacing="12">

            <!-- 标题 -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="本地 Ollama 一键运行" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="（检测安装 → 启动 ollama serve → 拉取 / 删除模型）"
                           Opacity="0.8" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 状态卡片 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="运行状态" FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="8" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ollama.exe：" Opacity="0.8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.ExePath, Mode=OneWay}"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="服务端口：" Opacity="0.8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="http://localhost:11434（REST API）"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="当前状态：" Opacity="0.8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="检测状态" Command="{x:Bind ViewModel.RefreshStatusCommand}"/>
                        <Button Content="一键启动" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.StartServeCommand}"/>
                        <Button Content="停止服务" Command="{x:Bind ViewModel.StopServeCommand}"/>
                        <Button Content="指定 ollama.exe…" Command="{x:Bind ViewModel.BrowseExeCommand}"/>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                      Width="20" Height="20" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="提示：若已安装 Ollama 桌面客户端，它通常会自动托管 11434 端口的服务，此时无需重复「一键启动」。"
                               Opacity="0.65" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 模型管理卡片 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="已安装模型" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="刷新" Command="{x:Bind ViewModel.RefreshModelsCommand}"/>
                        <Button Content="删除选中" Click="OnDeleteSelectedClick"/>
                    </StackPanel>

                    <ListView x:Name="ModelList"
                              ItemsSource="{x:Bind ViewModel.Models, Mode=OneWay}"
                              SelectionMode="Single"
                              Height="220">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" IsTextSelectionEnabled="True" Margin="0,4"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="拉取新模型（需联网，模型体积通常 1–8 GB）" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{x:Bind ViewModel.PullModel, Mode=TwoWay}"
                                 PlaceholderText="模型名，如 qwen2.5:3b / llama3.2:3b / deepseek-r1:7b / gemma2:9b"/>
                        <Button Grid.Column="1" Content="开始拉取" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.PullCommand}"/>
                    </Grid>

                    <TextBlock Text="拉取输出" Opacity="0.8" FontSize="12"/>
                    <ScrollViewer Height="140" VerticalScrollBarVisibility="Auto"
                                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                                  Padding="8" CornerRadius="4">
                        <TextBlock Text="{x:Bind ViewModel.PullLogText, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- 操作日志 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel Spacing="6">
                    <TextBlock Text="操作日志" FontWeight="SemiBold"/>
                    <ScrollViewer Height="120" VerticalScrollBarVisibility="Auto"
                                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                                  Padding="8" CornerRadius="4">
                        <TextBlock Text="{x:Bind ViewModel.LogText, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
