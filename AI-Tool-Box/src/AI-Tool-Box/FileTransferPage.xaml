<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AI_Tool_Box.Views.FileTransferPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:AI_Tool_Box.Services"
    xmlns:vm="using:AI_Tool_Box.ViewModels"
    xmlns:converters="using:AI_Tool_Box.Converters">

    <!--
        局域网传文件（LocalSend 协议：UDP 多播发现 + HTTP(S) v1/v2 REST 会话式传输）：
        整页放在 ScrollViewer 中，窄窗口下可上下滚动查看全部传输记录与错误信息；
        内部设备列表/发送队列/传输记录各有独立高度并自身滚动，避免整页无限高。
    -->
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True"/>
    </Page.Resources>

    <ScrollViewer Padding="16"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
        <StackPanel Spacing="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

            <!-- ===== 控制栏 ===== -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid ColumnSpacing="12" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0"
                            Content="{x:Bind ViewModel.ListenButtonText, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.ToggleListeningCommand}"
                            MinWidth="140" MinHeight="36"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"/>

                    <TextBox Grid.Row="0" Grid.Column="1"
                             Header="设备别名"
                             Text="{x:Bind ViewModel.Alias, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Width="150"
                             VerticalAlignment="Center"/>

                    <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.LocalInfo, Mode=OneWay}"
                                   FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                        <TextBlock Text="发现：UDP 多播 224.0.0.167:53317 · 传输：HTTP(S) /api/localsend/{v1,v2}（自动协商）"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ToggleSwitch Header="自动接收"
                                      OnContent="自动接收"
                                      OffContent="手动确认"
                                      IsOn="{x:Bind ViewModel.AutoAccept, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                        <TextBox Header="保存目录"
                                 Text="{x:Bind ViewModel.SaveDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 MinWidth="220" MaxWidth="420"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Center"/>
                        <Button Content="打开" Command="{x:Bind ViewModel.OpenSaveDirCommand}" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 设备 + 发送队列 ===== -->
            <Grid ColumnSpacing="12" Height="300">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="附近设备" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.OnlinePeers.Count, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            <Button Content="刷新"
                                    Command="{x:Bind ViewModel.RefreshCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsListening, Mode=OneWay}"
                                    Padding="10,4" MinWidth="0" MinHeight="0"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.OnlinePeers, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedPeer, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.IsListening, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="svc:LanPeer">
                                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,2">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18"
                                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Alias}"/>
                                            <TextBlock Text="{x:Bind IpAddress}" FontSize="11" FontFamily="Consolas"
                                                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="发送队列" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.PendingFiles.Count, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </StackPanel>
                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.PendingFiles, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedPendingFile, Mode=TwoWay}"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:QueuedFile">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind FileName}"
                                                   FontFamily="Consolas"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind SizeText}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <Button Content="选择文件…" Command="{x:Bind ViewModel.PickFilesCommand}"/>
                            <Button Content="移除选中" Command="{x:Bind ViewModel.RemoveSelectedCommand}"/>
                            <Button Content="清空" Command="{x:Bind ViewModel.ClearFilesCommand}"/>
                            <Button Content="发送到选中设备"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.SendCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== 拖放区 ===== -->
            <Border x:Name="DropZone"
                    MinHeight="100"
                    AllowDrop="True"
                    Background="Transparent"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="1"
                    DragOver="OnDropZoneDragOver"
                    DragLeave="OnDropZoneDragLeave"
                    Drop="OnDropZoneDrop">
                <Grid>
                    <Rectangle x:Name="DropDashOuter"
                               Stroke="{ThemeResource ApplicationSecondaryForegroundThemeBrush}"
                               StrokeThickness="1" StrokeDashArray="2 2" StrokeDashCap="Flat"
                               RadiusX="6" RadiusY="6"/>
                    <Rectangle x:Name="DropDashInner"
                               Margin="3"
                               Stroke="{ThemeResource ApplicationSecondaryForegroundThemeBrush}"
                               StrokeThickness="1" StrokeDashArray="2 2" StrokeDashCap="Flat"
                               RadiusX="4" RadiusY="4"/>
                    <Rectangle x:Name="DropHighlight"
                               Margin="3"
                               Fill="{ThemeResource AccentFillColorSecondaryBrush}"
                               Opacity="0.15"
                               RadiusX="4" RadiusY="4"
                               Visibility="Collapsed"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="将文件拖到此处，加入发送队列"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        <TextBlock Text="支持多选；也可点击「选择文件…」"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 传输记录 ===== -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="传输记录（进度 / 速度 / SHA256 校验 / 取消）"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                        <Button Content="打开日志目录" Click="OnOpenLogDirClick"
                                Padding="10,4" MinWidth="0" MinHeight="0"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                    <ListView Grid.Row="1"
                              Height="280"
                              ItemsSource="{x:Bind ViewModel.Transfers, Mode=OneWay}"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="svc:TransferProgress">
                                <Grid Padding="8,6" RowSpacing="4" ColumnSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{x:Bind DirectionText}"
                                               Width="42" FontWeight="Bold"
                                               Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{x:Bind FileName}"
                                               FontFamily="Consolas"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Text="{x:Bind SpeedText, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                    <Button Grid.Row="0" Grid.Column="3"
                                            Content="取消"
                                            Click="OnCancelTransferClick"
                                            Padding="10,2" MinWidth="0" MinHeight="24"
                                            Visibility="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource InvBoolVis}}"/>

                                    <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                                 Value="{x:Bind Percent, Mode=OneWay}"
                                                 Minimum="0" Maximum="100"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                                               FontSize="12"
                                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                               TextWrapping="Wrap">
                                        <Run Text="{x:Bind PeerDisplay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{x:Bind Status, Mode=OneWay}"/>
                                        <Run Text="{x:Bind Sha256Result, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- ===== 状态 / 错误信息（完整显示，可选中复制） ===== -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="当前状态 / 最近一次错误"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"/>
                    <TextBlock Text="{x:Bind ViewModel.LogDirectory, Mode=OneWay}"
                               FontSize="11"
                               FontFamily="Consolas"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
