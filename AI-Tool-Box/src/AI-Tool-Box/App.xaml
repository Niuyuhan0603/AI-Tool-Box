<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AI_Tool_Box.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:AI_Tool_Box.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- DataTemplate 内的 x:Bind 转换器会在模板根元素找不到本地资源时回退到应用资源，
                 因此放在这里可避免 "Cannot find a resource with the given key" 崩溃 -->
            <converters:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
